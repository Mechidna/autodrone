@@ -52,6 +52,13 @@ MsckfFeatureGeometryDiagnostics compute_feature_geometry(
   MsckfFeatureGeometryDiagnostics result;
   result.feature_id = feature->featid;
 
+  size_t pixel_count = 0;
+  double pixel_u_sum = 0.0;
+  double pixel_v_sum = 0.0;
+  double first_pixel_timestamp = std::numeric_limits<double>::infinity();
