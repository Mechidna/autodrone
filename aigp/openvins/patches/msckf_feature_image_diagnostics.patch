       anchor_cam_id = pair.first;
       most_measurements = pair.second.size();
     }
-    for (double timestamp : pair.second) {
+    const auto &pixels = feature->uvs.at(pair.first);
+    for (size_t index = 0; index < pair.second.size(); ++index) {
+      const double timestamp = pair.second.at(index);
       first_timestamp = std::min(first_timestamp, timestamp);
       last_timestamp = std::max(last_timestamp, timestamp);
+      if (index >= pixels.size())
+        continue;
+      const double u_px = pixels.at(index)(0);
+      const double v_px = pixels.at(index)(1);
+      if (!std::isfinite(u_px) || !std::isfinite(v_px))
+        continue;
+      pixel_count++;
+      pixel_u_sum += u_px;
+      pixel_v_sum += v_px;
+      result.min_u_px = std::min(result.min_u_px, u_px);
+      result.max_u_px = std::max(result.max_u_px, u_px);
+      result.min_v_px = std::min(result.min_v_px, v_px);
+      result.max_v_px = std::max(result.max_v_px, v_px);
+      if (timestamp < first_pixel_timestamp) {
+        first_pixel_timestamp = timestamp;
+        result.first_u_px = u_px;
+        result.first_v_px = v_px;
+      }
+      if (timestamp > last_pixel_timestamp) {
+        last_pixel_timestamp = timestamp;
+        result.last_u_px = u_px;
+        result.last_v_px = v_px;
+      }
     }
   }
+  if (pixel_count > 0) {
+    result.mean_u_px = pixel_u_sum / static_cast<double>(pixel_count);
+    result.mean_v_px = pixel_v_sum / static_cast<double>(pixel_count);
+  }
   if (result.observation_count < 2 || most_measurements == 0)
     return result;
