+const MsckfFeatureGeometryDiagnostics *find_feature_geometry(const MsckfUpdateDiagnostics &diagnostics, size_t feature_id) {
+  const auto match = std::find_if(
+      diagnostics.feature_geometry.begin(), diagnostics.feature_geometry.end(),
+      [feature_id](const MsckfFeatureGeometryDiagnostics &item) { return item.feature_id == feature_id; });
+  return match == diagnostics.feature_geometry.end() ? nullptr : &(*match);
+}
+
+struct PreparedMsckfFeature {
+  std::shared_ptr<Feature> feature;
+  Eigen::MatrixXd H_x;
+  Eigen::VectorXd residual;
+  std::vector<std::shared_ptr<Type>> Hx_order;
+  int grid_index = -1;
+};
+
+double finite_or(double value, double fallback) { return std::isfinite(value) ? value : fallback; }
+
+bool better_geometry_candidate(const PreparedMsckfFeature &a, const PreparedMsckfFeature &b,
+                               const MsckfUpdateDiagnostics &diagnostics) {
+  const auto *ga = find_feature_geometry(diagnostics, a.feature->featid);
+  const auto *gb = find_feature_geometry(diagnostics, b.feature->featid);
+  if (ga == nullptr || gb == nullptr)
+    return a.feature->featid < b.feature->featid;
+  const double a_parallax = finite_or(ga->max_parallax_deg, -std::numeric_limits<double>::infinity());
+  const double b_parallax = finite_or(gb->max_parallax_deg, -std::numeric_limits<double>::infinity());
+  if (a_parallax != b_parallax)
+    return a_parallax > b_parallax;
+  const double a_condition = finite_or(ga->condition_number, std::numeric_limits<double>::infinity());
+  const double b_condition = finite_or(gb->condition_number, std::numeric_limits<double>::infinity());
+  if (a_condition != b_condition)
+    return a_condition < b_condition;
+  const double a_chi2 = finite_or(ga->chi2_ratio, std::numeric_limits<double>::infinity());
+  const double b_chi2 = finite_or(gb->chi2_ratio, std::numeric_limits<double>::infinity());
+  if (a_chi2 != b_chi2)
+    return a_chi2 < b_chi2;
+  if (ga->observation_count != gb->observation_count)
+    return ga->observation_count > gb->observation_count;
+  return ga->feature_id < gb->feature_id;
+}
+
+int image_grid_index(const std::shared_ptr<State> &state, MsckfFeatureGeometryDiagnostics &geometry) {
+  const auto camera = state->_cam_intrinsics_cameras.find(geometry.last_camera_id);
+  if (camera == state->_cam_intrinsics_cameras.end() || !std::isfinite(geometry.mean_u_px) ||
+      !std::isfinite(geometry.mean_v_px) || camera->second->w() <= 0 || camera->second->h() <= 0)
+    return -1;
+  const int column = std::max(0, std::min(2, static_cast<int>(3.0 * geometry.mean_u_px / camera->second->w())));
+  const int row = std::max(0, std::min(2, static_cast<int>(3.0 * geometry.mean_v_px / camera->second->h())));
+  geometry.selection_grid_row = row;
+  geometry.selection_grid_col = column;
+  return 3 * row + column;
+}
+
