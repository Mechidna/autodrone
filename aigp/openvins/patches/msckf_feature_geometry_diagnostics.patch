+MsckfFeatureGeometryDiagnostics compute_feature_geometry(
+    const std::shared_ptr<Feature> &feature,
+    std::unordered_map<size_t, std::unordered_map<double, FeatureInitializer::ClonePose>> &clones_cam) {
+  MsckfFeatureGeometryDiagnostics result;
+  result.feature_id = feature->featid;
+
+  size_t anchor_cam_id = 0;
+  size_t most_measurements = 0;
+  double first_timestamp = std::numeric_limits<double>::infinity();
+  double last_timestamp = -std::numeric_limits<double>::infinity();
+  for (const auto &pair : feature->timestamps) {
+    result.observation_count += pair.second.size();
+    if (pair.second.size() > most_measurements) {
+      anchor_cam_id = pair.first;
+      most_measurements = pair.second.size();
+    }
+    for (double timestamp : pair.second) {
+      first_timestamp = std::min(first_timestamp, timestamp);
+      last_timestamp = std::max(last_timestamp, timestamp);
+    }
+  }
+  if (result.observation_count < 2 || most_measurements == 0)
+    return result;
+  result.track_duration_s = last_timestamp - first_timestamp;
+
+  const double anchor_timestamp = feature->timestamps.at(anchor_cam_id).back();
+  auto &anchor_clone = clones_cam.at(anchor_cam_id).at(anchor_timestamp);
+  const Eigen::Matrix3d &R_GtoA = anchor_clone.Rot();
+  const Eigen::Vector3d &p_AinG = anchor_clone.pos();
+  Eigen::Matrix3d A = Eigen::Matrix3d::Zero();
+  Eigen::Vector3d b = Eigen::Vector3d::Zero();
+  std::vector<Eigen::Vector3d> bearings_in_anchor;
+  std::vector<Eigen::Vector3d> camera_positions;
+
+  for (const auto &pair : feature->timestamps) {
+    for (size_t index = 0; index < pair.second.size(); ++index) {
+      auto &clone = clones_cam.at(pair.first).at(pair.second.at(index));
+      const Eigen::Matrix3d &R_GtoCi = clone.Rot();
+      const Eigen::Vector3d &p_CiinG = clone.pos();
+      Eigen::Vector3d bearing;
+      bearing << feature->uvs_norm.at(pair.first).at(index)(0),
+          feature->uvs_norm.at(pair.first).at(index)(1), 1.0;
+      bearing = R_GtoA * R_GtoCi.transpose() * bearing;
+      bearing.normalize();
+      const Eigen::Matrix3d Bperp = skew_x(bearing);
+      const Eigen::Matrix3d Ai = Bperp.transpose() * Bperp;
+      const Eigen::Vector3d p_CiinA = R_GtoA * (p_CiinG - p_AinG);
+      A += Ai;
+      b += Ai * p_CiinA;
+      bearings_in_anchor.push_back(bearing);
+      camera_positions.push_back(p_CiinG);
+    }
+  }
+
+  const Eigen::Vector3d p_f = A.colPivHouseholderQr().solve(b);
+  const Eigen::Vector3d singular_values = Eigen::JacobiSVD<Eigen::Matrix3d>(A).singularValues();
+  result.condition_number = std::abs(singular_values(0) / singular_values(2));
+  result.linear_depth_m = p_f(2);
+  result.linear_range_m = p_f.norm();
+
+  constexpr double radians_to_degrees = 57.2957795130823208768;
+  for (size_t first = 0; first < bearings_in_anchor.size(); ++first) {
+    for (size_t second = first + 1; second < bearings_in_anchor.size(); ++second) {
+      const double cosine = std::max(-1.0, std::min(1.0, bearings_in_anchor[first].dot(bearings_in_anchor[second])));
+      result.max_parallax_deg =
+          std::max(result.max_parallax_deg, std::acos(cosine) * radians_to_degrees);
+      result.max_camera_baseline_m =
+          std::max(result.max_camera_baseline_m, (camera_positions[first] - camera_positions[second]).norm());
+    }
+  }
+  return result;
+}
+
+MsckfFeatureGeometryDiagnostics *find_feature_geometry(MsckfUpdateDiagnostics &diagnostics, size_t feature_id) {
+  const auto match = std::find_if(
+      diagnostics.feature_geometry.begin(), diagnostics.feature_geometry.end(),
+      [feature_id](const MsckfFeatureGeometryDiagnostics &item) { return item.feature_id == feature_id; });
+  return match == diagnostics.feature_geometry.end() ? nullptr : &(*match);
+}
